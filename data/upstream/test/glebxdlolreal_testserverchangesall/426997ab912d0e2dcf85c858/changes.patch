+/* The rows' window is the band's whole width, out through the tile's own padding, and 10 px taller than the rows at
+   either end, which a tile made larger needs. A finger moves the rows sideways and still scrolls the page up and
+   down. */
+.section--unlocked .perk-strip {
+  display: grid;
+  grid-template-columns: repeat(9, var(--perk-tile));
+  gap: var(--perk-gap);
+  justify-content: center;
+  width: auto;
+  height: auto;
+  margin: -10px calc(-1 * var(--gutter));
+  padding-block: 10px;
+  overflow: hidden;
+  -webkit-mask: linear-gradient(to right, #0000, #000 24px, #000 calc(100% - 24px), #0000);
+  mask: linear-gradient(to right, #0000, #000 24px, #000 calc(100% - 24px), #0000);
+  touch-action: pan-y;
+}
+
+.section--unlocked .perk-strip > .icon-tile,
+.section--unlocked .perk-row > .icon-tile {
+  --tile-box: var(--perk-tile);
+  --tile: var(--perk-tile);
+  --tile-radius: calc(var(--perk-tile) / 4);
+  /* In the row's flow, and still the box its glyph is placed in. */
+  position: relative;
+  top: auto;
+  left: auto;
+  transform: none;
+}
+
+.section--unlocked .perk-strip > .icon-tile:nth-child(n + 10):nth-child(-n + 18) {
+  left: calc((var(--perk-tile) + var(--perk-gap)) / 2);
+}
+
+html:not(.fx-reduce) .section--unlocked .perk-strip .icon-tile {
+  animation: none;
+}
+
+/* With the script each row is a strip of its own, which the script moves; a tile is a layer of its own, so one made
+   larger costs nothing but its own redraw. */
+.section--unlocked .perk-strip.is-live {
+  display: block;
+}
+
+.section--unlocked .perk-row {
+  display: flex;
+  gap: var(--perk-gap);
+  width: max-content;
+  will-change: transform;
+}
+
+.section--unlocked .perk-row + .perk-row {
+  margin-top: var(--perk-gap);
+}
+
+.section--unlocked .perk-row > .icon-tile {
+  flex: none;
+  will-change: transform;
+}
+
+/* The paywall's other purchases, each its own tile and so plainly a button at rest: two by two, 56 high, 12
+   apart, the icon on the tiles' left line, the label after it, and no chevron. On this screen they are the
+   second thing to do, so they stay small; 56 holds a label of two lines, so both rows are one height. */
+.section--actions {
+  --action-min: 56px;
+}
+
+.section--actions .section-body {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: var(--space-12);
+}
+
+/* The icon stands out of the flow at the tile's start and the text keeps clear of it (--sep-inset is where a row's
+   text starts), which leaves the label as the row's only item. */
+.section--actions .cell {
+  min-height: var(--action-min);
+  padding-inline-start: var(--sep-inset);
+}
+
+/* Two lines of text keep 8 px over and under, and a third makes the tile taller. The kit's rule for a one-line row
+   with an icon sets 4 px there by a selector heavier than a section's own, so this one repeats that selector. */
+.section--actions .cell:has(> .cell-lead > .icon-tile):not(:has(> .cell-main > .cell-subtitle:not(:empty))) {
+  padding-block: var(--space-8);
+}
+
+.section--actions .cell + .cell::before {
+  display: none;
+}
+
+.section--actions .cell-lead {
+  position: absolute;
+  inset-block: 0;
+  inset-inline-start: var(--space-16);
+}
+
+.section--actions .cell-main {
+  flex: 0 1 auto;
+}
+
+.section--actions .cell-title {
+  font-size: var(--fs-sub);
+  font-weight: var(--fw-strong);
+  line-height: var(--lh-sub);
+}
+
+/* No chevron: the tile is the button. The Stars balance is not this small tile's business: it stays for screen
+   readers and shows on the Stars screen. */
+.section--actions .cell-chevron {
+  display: none;
+}
+
+.section--actions .cell-trail {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  overflow: hidden;
+  clip-path: inset(50%);
+}
+
+/* The giveaway's two prizes as one page: the switch's runtime state hides the other prize. */
+[data-prize-both="premium"] .gw-prize[data-prize="stars"],
+[data-prize-both="premium"] .gw-prize-part--stars,
+[data-prize-both="stars"] .gw-prize[data-prize="premium"],
+[data-prize-both="stars"] .gw-prize-part--premium {
+  display: none;
+}
