+  min-height: 48px;
+  margin: 0 auto;
+  padding: 0 var(--space-24);
+  border: 0;
+  border-radius: 24px;
+  background: var(--tone-solid);
+  box-shadow: var(--surface-shadow);
+  color: #fff;
+  font: inherit;
+  font-size: var(--fs-body);
+  font-weight: var(--fw-strong);
+  line-height: var(--lh-body);
+  cursor: pointer;
+}
+
+.cta-button:focus-visible {
+  outline: 2px solid var(--tone-solid);
+  outline-offset: 4px;
+}
+
+.cta-label {
+  overflow-x: hidden;
+  overflow-x: clip;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.cta-spinner {
+  position: absolute;
+  inset: 0;
+  width: 24px;
+  height: 24px;
+  margin: auto;
+  border: 2px solid rgba(255, 255, 255, 0.35);
+  border-top-color: #fff;
+  border-radius: 50%;
+  opacity: 0;
+  transition: opacity 200ms ease-out;
+}
+
+.cta-button.is-busy {
+  cursor: progress;
+}
+
+.cta-button.is-busy .cta-content {
+  opacity: 0;
+}
+
+.cta-button.is-busy .cta-spinner {
+  opacity: 1;
+  animation: spin 0.8s linear infinite;
+}
+
+.cta-button[aria-disabled='true'] {
+  background: var(--fill);
+  box-shadow: none;
+  color: var(--hint);
+  cursor: default;
+}
