diff --git a/i-/premiumbot.css b/i-/premiumbot.css
@@ -1,6 +1,111 @@
 /* Premium Bot Mini App: local additions on top of the design-system stylesheets
    (premiumbot-tokens/base/components/fx/screens-*.css). No framework, no preprocessor. */
 
+/* The site chrome's base styles ship link colours/underlines; cells and segments are not links visually. */
+.cell,
+.cell:hover,
+.cell:active,
+.cell:focus,
+.cell:visited,
+.segment,
+.segment:hover,
+.segment:active,
+.segment:focus,
+.segment:visited {
+  color: inherit;
+  text-decoration: none;
+  outline: none;
+}
+
+button.cell {
+  width: 100%;
+  text-align: start;
+}
+
+/* The plan's billing period under its price. */
+.plan-period {
+  color: var(--hint);
+  font-size: var(--fs-small);
+  line-height: var(--lh-small);
+}
+
+/* The gradient hero mark: the design's WebGL-free stage variant (flat premium/star glyph). */
+.pm-mark {
+  position: relative;
+  display: block;
+  width: 120px;
+  height: 120px;
+  margin: 0 auto var(--space-16);
+}
+
+.pm-mark-glyph {
+  position: absolute;
+  inset: 6%;
+  background: var(--brand-gradient, linear-gradient(90deg, #6b93ff, #976fff, #e169a0));
+  -webkit-mask: url(../img/premiumbot/ui-premium.svg) center / contain no-repeat;
+  mask: url(../img/premiumbot/ui-premium.svg) center / contain no-repeat;
+}
+
+.pm-mark--stars .pm-mark-glyph {
+  background: linear-gradient(180deg, #ffe071, #f5a623);
+  -webkit-mask-image: url(../img/premiumbot/ui-star.svg);
+  mask-image: url(../img/premiumbot/ui-star.svg);
+}
+
+.pm-mark--boost {
+  width: 104px;
+  height: 104px;
+}
+
+.pm-mark--boost .pm-mark-glyph {
+  background: linear-gradient(135deg, #6b93ff, #96b2ff);
+  -webkit-mask-image: url(../img/premiumbot/ui-boost.svg);
+  mask-image: url(../img/premiumbot/ui-boost.svg);
+}
+
+/* The golden star's soft halo. */
+.pm-mark-bloom {
+  position: absolute;
+  inset: -18%;
+  background: url(../img/premiumbot/star-bloom.svg) center / 100% 100% no-repeat;
+  opacity: 0.9;
+  mix-blend-mode: plus-lighter;
+  pointer-events: none;
+}
+
+.theme-light .pm-mark-bloom {
+  opacity: 0.55;
+  mix-blend-mode: normal;
+}
+
+/* Twinkling sparkles around the mark. */
+.pm-twinkle {
+  position: absolute;
+  border-radius: 50%;
+  background: radial-gradient(closest-side, var(--twinkle-c), transparent 80%);
+  opacity: 0;
+  animation: pm-twinkle 3.1s ease-in-out infinite;
+  pointer-events: none;
+}
+
+@keyframes pm-twinkle {
+  0%, 100% {
+    opacity: 0;
+    transform: scale(0.55);
+  }
+  45% {
+    opacity: 0.95;
+    transform: scale(1);
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .pm-twinkle {
+    animation: none;
+    opacity: 0.6;
+  }
+}
+
 /* Toasts: created by premiumbot.js inside .toast-region (base styles live in premiumbot-components.css). */
 
 /* Peer picker status line under the picker cell. */
